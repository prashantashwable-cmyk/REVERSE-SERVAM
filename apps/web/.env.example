# Supabase project (publishable values only — never put the service-role key in the web app).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# production | staging | demo  (demo shows a visible DEMO banner on every page)
NEXT_PUBLIC_AIEC_ENV=staging
