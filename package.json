{
  "name": "aiec-elevator-os",
  "private": true,
  "description": "AIEC Elevator Installation OS: domain rules, Supabase schema, admin web and field mobile app.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/mobile",
    "apps/demo",
    "supabase/tests"
  ],
  "scripts": {
    "test": "npm run test --workspace @aiec/domain",
    "test:db": "npm run test:db --workspace @aiec/db-tests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace @aiec/web",
    "build:demo": "npm run build --workspace @aiec/demo",
    "check:i18n": "node scripts/check-i18n.mjs",
    "seed:demo": "npm run seed:demo --workspace @aiec/db-tests"
  },
  "engines": {
    "node": ">=20.11"
  }
}
